<settings>
<category label="General">
		<setting id="DNS" type="text" label="DNS" default=""/>
		<setting id="Username" type="text" label="Username" default=""/>
		<setting id="Password" type="text" label="Password" default=""/>
		<setting id="meta" type="bool" label="VOD meta" visible="false" default="false"/>
		<setting id="hidexxx" type="bool" label="Show Adult" visible="false" default="false"/>
		<setting id="xxx_pwset" type="bool" label="Password Lock Adult Content" default="false"/>
		<setting id="xxx_pw" option="hidden" type="text" label="Adult Content Password (Default: 1234)" default="1234"/>
		<setting label="Test Credentials" type="action" action="RunPlugin(plugin://plugin.video.iptvxc/?mode=9)" option="close" />
	</category>
	<category label="Network">
		<setting id="net_timeout" type="number" label="Network timeout (seconds) — per-request timeout before retry" default="90" />
		<setting id="net_retries" type="number" label="Network retries — number of retry attempts for transient errors" default="2" />
		<setting id="net_backoff" type="number" label="Retry backoff (seconds) — base delay for exponential backoff (backoff * 2^(attempt-1))" default="1" />
		<setting label="Tip: Lower timeout makes UI more responsive on flaky networks; increase retries for unstable servers." type="label" />
	</category>
	<category label="Cache">
		<setting id="tv_cache_ttl" type="enum" label="Live TV cache expiry" values="5 minutes|15 minutes|30 minutes|1 hour|6 hours|12 hours|1 day|7 days" default="2"/>
		<setting id="movies_cache_ttl" type="enum" label="Movies cache expiry" values="5 minutes|15 minutes|30 minutes|1 hour|6 hours|12 hours|1 day|7 days" default="3"/>
		<setting id="series_cache_ttl" type="enum" label="Series cache expiry" values="5 minutes|15 minutes|30 minutes|1 hour|6 hours|12 hours|1 day|7 days" default="3"/>
		<setting label="Clear content cache now" type="action" action="RunPlugin(plugin://plugin.video.iptvxc/?mode=10&amp;url=clearcache)" />
	</category>
	<category label="Notifications">
		<setting id="expiry_notify_enabled" type="bool" label="Enable account expiry notifications" default="true" />
		<setting id="expiry_notify_days" type="text" label="Notify when less than X days remain" default="7" />
		<setting id="expiry_notify_interval_hours" type="number" label="Expiry check interval (hours)" default="24" />
	</category>
	<category label="Features">
		<setting id="max_history_items" type="number" label="Max items in watch history" default="25" />
		<setting id="telemetry_enabled" type="bool" label="Send anonymous usage ping (opt-out)" default="true" />
		<setting id="telemetry_endpoint" type="text" label="Telemetry endpoint (installs counter URL)" default="https://abacus.jasoncameron.dev/hit/iptvxc/installs" />
		<setting id="telemetry_daily_endpoint" type="text" label="Telemetry daily endpoint (daily counter URL)" default="https://abacus.jasoncameron.dev/hit/iptvxc/daily" />
	</category>
	<category label="Playback">
		<setting id="subtitles_live" type="bool" label="Enable subtitles for Live TV" default="false" />
		<setting id="subtitles_vod" type="bool" label="Enable subtitles for Movies/VOD" default="false" />
		<setting id="subtitles_series" type="bool" label="Enable subtitles for Series" default="false" />
		<setting id="auto_reconnect" type="bool" label="Auto-reconnect live streams" default="true" />
		<setting id="auto_reconnect_max_retries" type="number" label="Max reconnect retries" default="5" />
		<setting id="ts_resilience_enabled" type="bool" label=".ts stream resilience (reconnect)" default="true" />
		<setting id="ts_reconnect_delay" type="number" label="Reconnect delay/buffer tolerance (seconds)" default="20" />
		<setting id="live_timeshift_enabled" type="bool" label="Live TV Pause / Timeshift (.ts)" default="false" />
	</category>
	<category label="Trakt">
		<setting id="trakt_enabled" type="bool" label="Enable Trakt (via script.trakt addon)" default="false" />
	</category>
</settings>